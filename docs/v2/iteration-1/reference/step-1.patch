+struct TranscriptionStats: Equatable, Sendable {
+    var audioSeconds: Double = 0
+    /// Sent to the model, text came back.
+    var transcribedSeconds: Double = 0
+    /// Sent to the model, nothing came back.
+    var emptySeconds: Double = 0
